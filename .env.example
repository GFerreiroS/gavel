# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Battle.net client credentials, from https://develop.battle.net/access/clients
# Only "client credentials" are needed for auction-house data -- the full user
# OAuth flow is a separate, larger job and is not required here.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Required by Docker Compose. Generate a distinct value in the copied `.env`:
#   printf '\nAPP_CLUSTER_TOKEN=%s\n' "$(openssl rand -hex 32)" >> .env
# Deliberately empty here: examples must not ship a shared secret.
APP_CLUSTER_TOKEN=

# Optional one-shot administrator bootstrap. Set both for the first successful
# start and remove them immediately afterwards.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Optional. Without it, price alerts appear in the UI only.
# The webhook URL is itself a credential: anyone holding it can post.
DISCORD_WEBHOOK_URL=

# Optional, for the future Battle.net account-linking flow.
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
BATTLENET_REDIRECT_URI=http://127.0.0.1:3000/account/link/battlenet
