{$APP_DOMAIN} {
	# Caddy gets you automatic HTTPS (Let's Encrypt) for free just from
	# naming a real domain here -- nothing else to configure. The app already
	# sends its own CSP, nosniff, X-Frame-Options and no-store on every
	# response (README §10), so this proxy adds nothing but TLS and the
	# headers below.
	reverse_proxy 127.0.0.1:3000 {
		# APP_TRUST_PROXY_HEADERS is on in compose.web.yml, so these have to
		# be trustworthy: this is the only hop between Caddy and the app.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
