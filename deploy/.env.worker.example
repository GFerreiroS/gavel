# Copy to .env beside compose.worker.yml on each compute machine, then fill
# in. This file is gitignored (the root .gitignore's bare ".env" rule matches it too); never commit real values.

# Must match the web machine's APP_CLUSTER_TOKEN exactly, or every worker on
# this machine is turned away before it reaches the registry.
APP_CLUSTER_TOKEN=

# The web machine's private-network address and port 3001, e.g.
# 10.0.10.10:3001 -- not its public domain, and not port 3000.
WEB_ADDR=
