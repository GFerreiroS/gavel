# Copy to .env beside compose.web.yml on the web/data machine, then fill in.
# This file is gitignored (the root .gitignore's bare ".env" rule matches it too); never commit real values.

# Battle.net client credentials, from https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Shared with every worker machine's .env. Generate once:
#   openssl rand -hex 32
APP_CLUSTER_TOKEN=

# Optional one-shot administrator bootstrap. Set both for the first
# successful start, confirm the log line, then blank them and
# `docker compose up -d` again.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# This VM's Tailscale IP (100.x.y.z -- `tailscale ip -4` after `tailscale up`),
# NOT its public/WAN or Proxmox-LAN address. Both :3000 and :3001 bind to
# this address only; see compose.web.yml and the networking section of
# deploy/README.md.
TAILSCALE_ADDR=

# Comma-separated, no spaces: eu,us,kr,tw. One is enough to start with.
APP_MARKET_REGIONS=eu
